// Base build config for the DigiFridgy app target.
// SpacetimeDB backend (not secret). Host has no scheme because xcconfig treats "//" as a comment;
// the app uses https, or http for localhost / 127.x. Override in Secrets.xcconfig if needed.
SPACETIME_HOST = maincloud.spacetimedb.com
SPACETIME_DB = digifridgy-hud4l

// Empty defaults so the project builds without secrets; Secrets.xcconfig overrides them.
EDAMAM_APP_ID =
EDAMAM_APP_KEY =
KROGER_CLIENT_ID =
KROGER_CLIENT_SECRET =
CALORIENINJAS_KEY =
WALMART_CONSUMER_ID =
WALMART_KEY_VERSION = 1
WALMART_PRIVATE_KEY =
BLUECART_API_KEY =
REDCIRCLE_API_KEY =

// DigiFridgey bank/iMessage server (backend/). Defaults to the shared backend behind the Cloudflare tunnel
// (backend/cloudflared.yml). Override in Secrets.xcconfig to use your own; "//" starts a comment in xcconfig, so
// write the URL as http:/$()/192.168.1.20:8010, or leave out the scheme and the app adds http://.
DIGIFRIDGEY_SERVER = https:/$()/digifridgy.soumilvoona.me
// Optional operator token (the server's DEMO_TOKEN), sent as the X-Demo-Token header. App users don't need it:
// their requests carry their SpacetimeDB sign-in token as Authorization: Bearer.
DIGIFRIDGEY_TOKEN =

#include? "Secrets.xcconfig"
