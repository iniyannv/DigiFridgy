// Copy to Config/Secrets.xcconfig (gitignored) and fill in.
// DEMO ONLY: values end up in the app bundle and are extractable. Never ship this.
// Values must not contain "//" (xcconfig treats it as a comment).
EDAMAM_APP_ID =
EDAMAM_APP_KEY =
KROGER_CLIENT_ID =
KROGER_CLIENT_SECRET =
CALORIENINJAS_KEY =

// Walmart Affiliate API (walmart.io): consumer ID + key version from the app's dashboard, and the RSA private
// key whose public half you uploaded, as one base64url line (no "/" so no "//"). Make it with:
//   openssl rsa -in WM_IO_private_key.pem -outform DER | base64 | tr '/+' '_-' | tr -d '=\n'
WALMART_CONSUMER_ID =
WALMART_KEY_VERSION = 1
WALMART_PRIVATE_KEY =

// Traject Data product search on the Stores tab. Separate signups, each with a free 100-request trial:
// BlueCart (Walmart) at app.bluecartapi.com/signup, RedCircle (Target) at app.redcircleapi.com/signup.
BLUECART_API_KEY =
REDCIRCLE_API_KEY =

// Optional: point the app at a different SpacetimeDB server/database (defaults in Base.xcconfig).
// SPACETIME_HOST = 127.0.0.1:3000
// SPACETIME_DB = digifridgy-hud4l

// Optional: the DigiFridgey bank server (backend/) for a device build. Use your Mac's Wi-Fi address.
// "//" starts a comment in xcconfig: write http:/$()/host:port, or just host:port (the app adds http://).
// DIGIFRIDGEY_SERVER = 192.168.1.20:8010
// Optional operator token (the server's DEMO_TOKEN). Normal app requests are authorized by the sign-in token.
// DIGIFRIDGEY_TOKEN =
