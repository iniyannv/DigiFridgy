# Copy to backend/.env (gitignored). Anything left empty falls back to a SIMULATED mock.

# Capital One Nessie
NESSIE_API_KEY=
NESSIE_BASE_URL=https://prod-api.nessieisreal.com

# Photon 2.0 (Beta) - key needs project:read, project:write, platforms:read, platforms:write
# (platforms:* lets /signup assign a shared iMessage line to each person's phone number)
PHOTON_API_KEY=
PHOTON_PROJECT_ID=            # pho_prj_...
PHOTON_PLATFORM=imessage
PHOTON_AGENT_HANDLE=          # fallback line, e.g. +14155550188 (sign-ups get their own assigned line)
PHOTON_WEBHOOK_SECRET=        # optional (whsec_...); set automatically when PUBLIC_URL registers the webhook
PUBLIC_URL=                   # e.g. https://<name>.trycloudflare.com: registers the Photon webhook at startup
ALLOWED_HANDLES=              # optional comma list of phones/emails allowed to talk to the agent

# ElevenLabs voice agent -> /voice/tools/* (sent as header X-Tool-Secret)
VOICE_TOOL_SECRET=

# SpacetimeDB: the iOS app's database, so iMessage and the app share one fridge
# (values below are the published module in ../server; leave empty to keep the app sync SIMULATED)
SPACETIME_HOST=maincloud.spacetimedb.com
SPACETIME_DB=digifridgy-hud4l

# Optional Gemini for natural-language phrasing (keywords always work without it)
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

DEMO_MODE=true
DEMO_TOKEN=                   # optional: protects /demo/* if the server is public
TIMEZONE=America/Chicago

# Force mocks on/off (default: on when the matching key is missing)
# USE_MOCK_NESSIE=false
# USE_MOCK_PHOTON=false
# USE_MOCK_SPACETIME=false
