rules_version = '2';

// DigiFridgy security rules.
// Paste into Firebase console → Firestore → Rules, or deploy with `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(hid) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.memberUids;
    }

    // A user's profile is private to that user.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /households/{hid} {
      // Members read their household. Non-members may only run the invite-code lookup
      // (a query limited to one result) so they can join.
      allow get: if isMember(hid);
      allow list: if signedIn() && request.query.limit <= 1;

      // Create a household with yourself as the only member.
      allow create: if signedIn()
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() == 6;

      // Members may update anything except the invite code.
      // Non-members may only append their own uid (joining via arrayUnion).
      // Members may remove themselves (leaving).
      allow update: if signedIn() && (
        (isMember(hid)
          && request.resource.data.inviteCode == resource.data.inviteCode)
        ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid]))
      );

      allow delete: if false;

      // Items, shopping list and price history: members only.
      match /{subcollection}/{docId} {
        allow read, write: if isMember(hid);
      }
    }
  }
}
